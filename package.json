{
  "name": "heliox-ide",
  "productName": "Heliox IDE",
  "version": "0.1.0",
  "description": "Visual-first IDE with AI agents and E2E snapshot validation. Logo: HeO2",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "rm -rf .vite dist && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "heliox:baseline": "node -e \"console.log('Run baselines via Heliox IDE UI — Flows tab → Initialize Baselines')\"",
    "build:bridge": "vite build --config vite.bridge.config.ts",
    "heliox:init": "node -e \"const fs=require('fs'),p=require('path');const d=p.join(process.cwd(),'heliox');if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});['flows.json','metrics.config.json'].forEach(f=>{const fp=p.join(d,f);if(!fs.existsSync(fp))fs.copyFileSync(p.join(__dirname,'assets','heliox-templates',f),fp)});console.log('Heliox config initialized in ./heliox/')\""
  },
  "devDependencies": {
    "@electron-forge/cli": "^7",
    "@electron-forge/maker-deb": "^7",
    "@electron-forge/maker-dmg": "^7",
    "@electron-forge/maker-rpm": "^7",
    "@electron-forge/maker-squirrel": "^7",
    "@electron-forge/plugin-vite": "^7",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron-forge/shared-types": "^7",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/better-sqlite3": "7.6.13",
    "@types/pngjs": "^6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6",
    "autoprefixer": "^10",
    "electron": "^41",
    "electron-builder": "^26.8.1",
    "eslint": "^10",
    "jsdom": "^29",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8",
    "vitest": "^4"
  },
  "overrides": {
    "tar": ">=7.5.11",
    "tmp": ">=0.2.4",
    "@tootallnate/once": ">=3.0.1",
    "http-proxy-agent": ">=6.0.0",
    "cacache": ">=19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6",
    "@dnd-kit/modifiers": "^9",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1",
    "@xyflow/react": "12.10.2",
    "better-sqlite3": "12.8.0",
    "electron-store": "11.0.2",
    "pixelmatch": "^7",
    "playwright": "^1",
    "pngjs": "^7",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5",
    "react-markdown": "^10.1.0",
    "ws": "8.20.0",
    "zustand": "^5"
  }
}
