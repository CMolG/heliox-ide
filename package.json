{
  "name": "fluxor-ide",
  "productName": "Fluxor IDE",
  "version": "0.2.0",
  "description": "Open-source dashboard for designing agentic flows — compose visually, verify by execution, and export portable flows that run across TypeScript, Java, and Python.",
  "author": "Fluxor",
  "license": "Apache-2.0",
  "main": ".vite/build/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "rm -rf .vite dist && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "lint": "eslint src",
    "pf:run": "tsx src/main/performance-frontier/cli.ts",
    "pf:bench": "tsx src/main/performance-frontier/bench/cli.ts",
    "pf:arena": "tsx src/main/performance-frontier/arena/arena-runner.ts",
    "pf:compare": "tsx src/main/performance-frontier/compare/cli.ts",
    "fluxor:baseline": "node -e \"console.log('Run baselines via Fluxor IDE UI — Flows tab → Initialize Baselines')\"",
    "build:bridge": "vite build --config vite.bridge.config.ts",
    "fluxor:init": "node -e \"const fs=require('fs'),p=require('path');const d=p.join(process.cwd(),'fluxor');const legacy=p.join(process.cwd(),'heliox');if(fs.existsSync(legacy)&&!fs.existsSync(d)){fs.renameSync(legacy,d);console.log('Legacy compat: migrated ./heliox/ to ./fluxor/');}if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});['flows.json','metrics.config.json'].forEach(f=>{const fp=p.join(d,f);if(!fs.existsSync(fp))fs.copyFileSync(p.join(__dirname,'assets','fluxor-templates',f),fp)});console.log('Fluxor config initialized in ./fluxor/')\"",
    "fluxor:serve": "tsx src/main/serve/cli.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pngjs": "^6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6",
    "autoprefixer": "^10",
    "axe-core": "^4.12.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16",
    "vitest": "^4"
  },
  "overrides": {
    "tar": "7.5.16",
    "tmp": "0.2.7",
    "@tootallnate/once": ">=3.0.1",
    "http-proxy-agent": ">=6.0.0",
    "cacache": ">=19.0.0",
    "@xmldom/xmldom": "0.8.13",
    "fast-uri": "3.1.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.80",
    "@ai-sdk/openai": "^3.0.65",
    "@dnd-kit/core": "^6",
    "@dnd-kit/modifiers": "^9",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3",
    "@fontsource-variable/doto": "^5.2.10",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1",
    "@xyflow/react": "12.10.2",
    "ai": "^6.0.190",
    "better-sqlite3": "12.8.0",
    "electron-store": "11.0.2",
    "memfs": "^4.57.8",
    "monaco-editor": "^0.53.0",
    "pixelmatch": "^7",
    "playwright": "^1",
    "pngjs": "^7",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^8.5.0",
    "update-electron-app": "^3.3.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76",
    "zustand": "^5"
  }
}
