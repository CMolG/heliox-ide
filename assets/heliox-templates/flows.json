{
  "$schema": "https://heliox.dev/schemas/flows.json",
  "flows": [
    {
      "id": "flow-homepage",
      "name": "Homepage Load",
      "baseUrl": "http://localhost:3000",
      "steps": [
        {
          "id": "step-navigate-home",
          "name": "Navigate to homepage",
          "action": "navigate",
          "target": "/"
        },
        {
          "id": "step-wait-hero",
          "name": "Wait for hero section",
          "action": "wait",
          "target": "[data-testid='hero'], main, h1"
        }
      ]
    }
  ]
}
